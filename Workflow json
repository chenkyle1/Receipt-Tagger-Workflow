      "parameters": {
        "jsCode": "// Retrieve the binary item reference from the preceding node\nconst item = $input.item;\nconst binaryData = item.binary?.data;\n\nif (!binaryData) {\n  throw new Error(\"No binary data found in input! Check that the Google Drive Download node runs immediately before this step.\");\n}\n\n// 1. Fetch the actual raw file buffer from n8n binary storage (resolves 'filesystemv2')\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\n// 2. Convert raw buffer to a real Base64 string\nconst cleanBase64 = buffer.toString('base64');\n\n// 3. Form the valid Data URL\nconst mimeType = binaryData.mimeType || 'image/jpeg';\nconst dataUrl = `data:${mimeType};base64,${cleanBase64}`;\n\nconst promptText = `You are an expert OCR and document processing assistant specializing in structured data extraction.\\n\\nAnalyze the provided receipt image and extract the key information into a single, valid JSON object. Do not include any explanations, Markdown block wrappers, or conversational text—output ONLY raw JSON.\\n\\nSchema:\\n{\\n  \"merchant\": { \"name\": null, \"address\": null, \"phone_number\": null },\\n  \"transaction\": { \"date\": null, \"time\": null, \"receipt_number\": null, \"payment_method\": null, \"card_last_four\": null },\\n  \"line_items\": [{ \"description\": \"\", \"quantity\": 1, \"unit_price\": null, \"total_price\": 0 }],\\n  \"financials\": { \"subtotal\": null, \"tax\": null, \"tip\": null, \"discount\": null, \"grand_total\": 0 },\\n  \"metadata\": { \"currency\": null, \"confidence_score\": \"High\" }\\n}`;\n\nreturn {\n  json: {\n    payload: {\n      model: \"deepseek-v4-flash-vision-exp\",\n      messages: [\n        {\n          role: \"user\",\n          content: [\n            { type: \"text\", text: promptText },\n            {\n              type: \"image_url\",\n              image_url: { url: dataUrl }\n            }\n          ]\n        }\n      ]\n    }\n  }\n};"
      },
