      "parameters": {
        "jsCode": "// Function to format ALL CAPS text into Title Case\nfunction toTitleCase(str) {\n  return str.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n}\n\n// Extract raw data from the incoming node payload\nconst rawData = $input.item.json;\n\n// Handle nested structure whether wrapped in 'payload' or directly in 'json'\nconst responseText = rawData.choices?.[0]?.message?.content || rawData;\nconst receipt = typeof responseText === 'string' ? JSON.parse(responseText) : responseText;\n\n// 1. Clean Merchant Details\nif (receipt.merchant) {\n  // Format phone number to clean XXX-XXX-XXXX\n  if (receipt.merchant.phone_number) {\n    const digits = receipt.merchant.phone_number.replace(/\\D/g, '');\n    if (digits.length === 10) {\n      receipt.merchant.phone_number = `${digits.slice(0, 3)}-${digits.slice(3, 6)}-${digits.slice(6)}`;\n    }\n  }\n  // Standardize state/zip formatting\n  if (receipt.merchant.address) {\n    receipt.merchant.address = receipt.merchant.address.replace(/\\bMA 1760\\b/, 'MA 01760');\n  }\n}\n\n// 2. Clean Transaction\nif (receipt.transaction?.payment_method) {\n  if (/american express/i.test(receipt.transaction.payment_method)) {\n    receipt.transaction.payment_method = 'Amex';\n  }\n}\n\n// 3. Clean Line Items (Strip SKUs, convert to Title Case, and consolidate duplicates)\nif (Array.isArray(receipt.line_items)) {\n  const cleanedMap = new Map();\n\n  for (const item of receipt.line_items) {\n    // Remove leading SKU/item numbers (e.g., \"66538 GOGGLES\" -> \"GOGGLES\")\n    let desc = item.description.replace(/^\\d+\\s+/, '').trim();\n    \n    // Convert to Title Case\n    desc = toTitleCase(desc);\n\n    const key = desc.toLowerCase();\n\n    if (cleanedMap.has(key)) {\n      // Consolidate duplicate items\n      const existing = cleanedMap.get(key);\n      existing.quantity += item.quantity || 1;\n      existing.total_price = Number((existing.total_price + item.total_price).toFixed(2));\n    } else {\n      cleanedMap.set(key, {\n        description: desc,\n        quantity: item.quantity || 1,\n        unit_price: item.unit_price,\n        total_price: item.total_price\n      });\n    }\n  }\n\n  receipt.line_items = Array.from(cleanedMap.values());\n}\n\nreturn { json: receipt };"
